RewriteEngine On

RewriteCond %{REQUEST_URI} ^/api/(.*)$
RewriteRule ^api/(.*)$ http://localhost:5050/api/$1 [P,L]

RewriteCond %{REQUEST_URI} ^/pro-api/(.*)$
RewriteRule ^pro-api/(.*)$ http://91.107.232.169:6000/$1 [P,L]

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.html [L]
</IfModule>
